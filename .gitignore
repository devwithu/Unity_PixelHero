/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

sysinfo.txt
crashlytics-buildid.txt
*.pidb.meta
*.pdb.meta
*.mdb.meta

# IDE files Unity generates from the asmdefs (CLAUDE.md: never build them with dotnet)
/*.csproj
/*.sln
/*.slnx
*.pidb
*.pdb
*.mdb
*.opendb
*.VC.db
*.suo
*.user
*.userprefs

