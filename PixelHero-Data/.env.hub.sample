# 운영 설정: 허브만 있는 머신 (hub.jdj.kr), 게임 서버는 다른 머신
#
# 허브 머신의 /opt/pixelhero/PixelHero-Data/.env 로 복사한 뒤 <...> 부분을 채웁니다 (live.md §3).
# 주석은 별도 줄에만 씁니다. 이 파일에는 실제 HUB_ACCESS_TOKEN이 있으므로 git에 올리지 않습니다.

# 허브 로그에만 쓰이는 이름
NAME='pixelhero'
GVER='0.1.1'
SSL=false

# === 허브 ===
HUB_ENABLED=true
# 허브 http API (게임 서버 머신에서만 접속 허용: 방화벽)
HUB_PORT=59526
# 허브 ws (게임 서버 머신에서만 접속 허용: 방화벽)
HUB_WS_PORT=59527
# 허브 https API (외부 공개)
HUB_SSL_PORT=59536
# 게임 서버들과 같은 값
HUB_ACCESS_TOKEN='******'
RESET_URL='https://pixelhero.jdj.kr/?hub=https://hub.jdj.kr:59536'

# === TLS (허브 https API가 씀, *.jdj.kr) ===
SSL_CERTIFICATE='/opt/pixelhero/certs/fullchain.pem'
SSL_CERTIFICATE_KEY='/opt/pixelhero/certs/privkey.pem'
SSL_CERTIFICATE_PASSWORD=''

# === 데이터베이스 (허브는 항상 DB에 접속: 순위표, 비밀번호 재설정) ===
SKIP_DATABASE=false
DATABASE='mongodb'
MONGODB_HOST=base2.jdj.kr
MONGODB_PORT=27017
MONGODB_USER='pixelhero'
MONGODB_PASSWORD=******
MONGODB_DATABASE='pixelhero'
MONGODB_AUTH_SOURCE='pixelhero'
MONGODB_TLS=false
MONGODB_SRV=false
AGGREGATE_THRESHOLD=60000

# 서버 목록에서 응답 없는 게임 서버를 지우는 기준 (ms)
CLEANUP_THRESHOLD=120000
CLEANUP_TIME=30000

# === 메일 ===
SMTP_HOST='smtp.gmail.com'
SMTP_PORT=465
SMTP_USE_SECURE=true
SMTP_USER=******@gmail.com
# Gmail 앱 비밀번호 (16자)
SMTP_PASSWORD=******

# === Discord ===
DISCORD_ENABLED=true
DISCORD_BOT_TOKEN=******
DISCORD_CHANNEL_ID=`******`

DEBUGGING=false
DEBUG_LEVEL='all'
FS_DEBUGGING=false
