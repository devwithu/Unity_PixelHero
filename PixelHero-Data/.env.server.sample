# 운영 설정: 게임 서버만 있는 머신 (허브는 hub.jdj.kr)
#
# 게임 서버 머신의 /opt/pixelhero/PixelHero-Data/.env 로 복사한 뒤 <...> 부분을 채웁니다 (live.md §3).
# 서버마다 바꿀 값: NAME, SERVER_ID, REMOTE_SERVER_HOST (live.md §1의 표)
#   beta → 1, beta.jdj.kr / gamma → 2, gamma.jdj.kr / delta → 3, delta.jdj.kr
# 주석은 별도 줄에만 씁니다. 이 파일에는 실제 HUB_ACCESS_TOKEN이 있으므로 git에 올리지 않습니다.

NAME='beta'
SERVER_ID=1
GVER='0.1.1'

# === 게임 서버 접속 ===
HOST='127.0.0.1'
# ws 리스너 (내부 전용)
PORT=59011
SSL=false

# === TLS (*.jdj.kr) ===
# wss (외부 공개). WebGL 빌드가 59443으로 접속하므로 바꾸지 않습니다.
SSL_PORT=59443
SSL_CERTIFICATE='/opt/pixelhero/certs/fullchain.pem'
SSL_CERTIFICATE_KEY='/opt/pixelhero/certs/privkey.pem'
SSL_CERTIFICATE_PASSWORD=''

# 허브를 켜면 자동으로 열리는 서버 정보 API (내부 전용)
API_ENABLED=false
API_PORT=59002

# === 허브 연결 ===
HUB_ENABLED=true
# 허브 머신 주소. 사설망이 있으면 사설 IP를 씁니다 (허브 연결은 암호화되지 않음).
HUB_HOST='hub.jdj.kr'
HUB_WS_HOST='hub.jdj.kr'
HUB_PORT=59526
HUB_WS_PORT=59527
HUB_ACCESS_TOKEN='******'
# 브라우저가 접속할 이 머신의 도메인 (*.jdj.kr 인증서 이름과 맞아야 함)
REMOTE_SERVER_HOST='beta.jdj.kr'
REMOTE_API_HOST=''

# === 데이터베이스 ===
SKIP_DATABASE=false
DATABASE='mongodb'
MONGODB_HOST=base2.jdj.kr
MONGODB_PORT=27017
MONGODB_USER='pixelhero'
MONGODB_PASSWORD=******
MONGODB_DATABASE='pixelhero'
MONGODB_AUTH_SOURCE='pixelhero'
MONGODB_TLS=false
MONGODB_SRV=false

# === 월드 ===
TUTORIAL_ENABLED=true
OVERWRITE_AUTH=false
DISABLE_REGISTER=false
MAX_PLAYERS=100
SAVE_INTERVAL=60000
MESSAGE_LIMIT=300

# 허브를 켜면 Discord는 허브가 맡습니다.
DISCORD_ENABLED=false

DEBUGGING=false
DEBUG_LEVEL='all'
FS_DEBUGGING=false
