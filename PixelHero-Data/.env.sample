# 운영 설정: 허브와 게임 서버(beta)를 한 머신(hub.jdj.kr)에 둘 때
#
# 운영 서버의 /opt/pixelhero/PixelHero-Data/.env 로 복사한 뒤 <...> 부분을 채웁니다 (live.md §3).
# 나누어 둘 때는 .env.hub.sample(허브 머신)과 .env.server.sample(게임 서버 머신)을 씁니다.
# 순서: PixelHero-Data/.env.defaults → 이 파일 → 명령줄 --key value
#
# 주의 (dotenv 8.6.0 규칙)
# - 값 뒤에 "# 주석"을 붙이면 주석까지 값이 됩니다. 주석은 반드시 별도 줄에 씁니다.
# - Discord 채널 ID(19자리)는 백틱으로 감쌉니다. 감싸지 않으면 숫자로 읽혀 반올림됩니다.
# - HUB_ACCESS_TOKEN이 실제 값으로 들어 있습니다. 이 파일은 git에 올리지 않습니다(.gitignore에 추가함).
#   운영 서버에서는 chmod 600 으로 둡니다.


# === 서버 이름과 번호 (허브의 월드 선택에 이 이름이 나옴) ===
NAME='beta'
SERVER_ID=1
GVER='0.1.1'

# === 게임 서버 접속 ===
HOST='127.0.0.1'
# ws 리스너 (내부 전용)
PORT=59011
# 원본 클라이언트 전용. true면 /isOnline 주소에서 포트가 빠져 실패하므로 false로 둡니다.
SSL=false

# === TLS (*.jdj.kr Let's Encrypt, live.md §5) ===
# 게임 서버 wss (외부 공개). WebGL 빌드가 59443으로 접속하므로 바꾸지 않습니다.
SSL_PORT=59443
SSL_CERTIFICATE='/opt/pixelhero/certs/fullchain.pem'
SSL_CERTIFICATE_KEY='/opt/pixelhero/certs/privkey.pem'
SSL_CERTIFICATE_PASSWORD=''

# === 게임 서버 HTTP API (허브를 켜면 자동으로 열림, 내부 전용) ===
API_ENABLED=false
API_PORT=59002

# === 허브 ===
HUB_ENABLED=true
# 게임 서버 → 허브 주소 (같은 머신)
HUB_HOST='127.0.0.1'
HUB_WS_HOST='127.0.0.1'
# 허브 http API (내부 전용: 게임 서버의 /isOnline)
HUB_PORT=59526
# 허브 ws (내부 전용: 게임 서버 등록·중계)
HUB_WS_PORT=59527
# 허브 https API (외부 공개: 브라우저의 월드 선택, 순위표, 비밀번호 재설정)
HUB_SSL_PORT=59536
# 허브와 모든 게임 서버에 같은 값
HUB_ACCESS_TOKEN='******'
# 허브가 브라우저에 알려 줄 이 게임 서버의 주소 (브라우저는 wss://<이 값>:59443 으로 접속)
REMOTE_SERVER_HOST='hub.jdj.kr'
REMOTE_API_HOST=''
# 비밀번호 재설정 메일 링크 (WebGL 페이지). 허브가 &token=…&id=… 를 붙입니다.
RESET_URL='https://pixelhero.jdj.kr/?hub=https://hub.jdj.kr:59536'

# === 데이터베이스 (live.md §6) ===
SKIP_DATABASE=false
DATABASE='mongodb'
MONGODB_HOST='<MongoDB 호스트>'
MONGODB_PORT=27017
MONGODB_USER='pixelhero'
MONGODB_PASSWORD='<MongoDB 비밀번호>'
MONGODB_DATABASE='pixelhero'
MONGODB_AUTH_SOURCE='pixelhero'
MONGODB_TLS=false
MONGODB_SRV=false
AGGREGATE_THRESHOLD=60000

# === 월드 ===
TUTORIAL_ENABLED=true
# 절대 true로 두지 않습니다 (아무 비밀번호로나 로그인됨).
OVERWRITE_AUTH=false
DISABLE_REGISTER=false
MAX_PLAYERS=100
SAVE_INTERVAL=60000
MESSAGE_LIMIT=300

# === 메일 (비밀번호 재설정, 허브가 보냄) ===
SMTP_HOST='smtp.gmail.com'
SMTP_PORT=465
SMTP_USE_SECURE=true
SMTP_USER='<보내는 Gmail 주소>'
# Gmail 앱 비밀번호 (16자)
SMTP_PASSWORD='<앱 비밀번호>'

# === Discord (허브가 접속함, 게임 서버는 허브를 켜면 접속하지 않음) ===
DISCORD_ENABLED=true
DISCORD_CHANNEL_ID=`<채널 ID>`
DISCORD_BOT_TOKEN='<봇 토큰>'

# === 로그 ===
DEBUGGING=false
DEBUG_LEVEL='all'
FS_DEBUGGING=false
